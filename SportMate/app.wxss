page {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: #f5f7fa;
    color: #333;
    font-size: 14px;
  }
  .container {
    padding: 10px 15px;
    box-sizing: border-box;
  }
  .button {
    width: 80%;
    height: 44px;
    line-height: 44px;
    border-radius: 22px;
    background-color: #36BFFA;
    color: #fff;
    text-align: center;
    margin: 15px auto;
    font-size: 16px;
  }